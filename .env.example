# Schwab API Credentials (REQUIRED)
SCHWAB_APP_KEY=your-app-key-here
SCHWAB_APP_SECRET=your-app-secret-here
SCHWAB_REFRESH_TOKEN=your-refresh-token-here

# Database
DATABASE_URL=sqlite:///./execution_engine.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/execution_engine

# Server
HOST=0.0.0.0
PORT=8000
ENV=development

# Kill switch (default: OFF)
KILL_SWITCH_ENABLED=false

# Account allowlist (comma-separated)
ACCOUNT_ALLOWLIST=primary,secondary

# Symbol configuration
SYMBOL_ALLOWLIST=QQQ,SPY,IWM,EEM,GLD,TLT
SYMBOL_DENYLIST=

# Risk limits
MAX_ORDER_NOTIONAL_USD=100000
MAX_POSITION_CONCENTRATION_PCT=15
MARKET_HOURS_ONLY=true

# API Security
API_KEY_ADMIN=your-admin-api-key-here
REQUEST_SIGNING_ENABLED=false
REQUEST_SIGNING_PRIVATE_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Schwab API settings
SCHWAB_API_TIMEOUT_SEC=30
SCHWAB_PREVIEW_TIMEOUT_SEC=10
SCHWAB_PREVIEW_EXPIRY_MIN=5
SCHWAB_RETRY_MAX_ATTEMPTS=3
SCHWAB_RETRY_BACKOFF_SEC=1
