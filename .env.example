# Execution defaults to non-networked paper simulation. Set this to
# anything other than PAPER/SHADOW (e.g. SCHWAB) to switch to the real
# Schwab adapter below, once configured. This alone is still not enough to
# place a real order — see SCHWAB_LIVE_TRADING_ENABLED further down, a
# second, independent switch (SchwabBrokerAdapter.submit_order checks
# both). With this set but that one left false, only quotes, balances,
# positions, and order PREVIEW make real calls — submission stays refused.
EXECUTION_MODE=PAPER

# Schwab OAuth (required only when EXECUTION_MODE is not PAPER/SHADOW).
# SCHWAB_APP_KEY / SCHWAB_APP_SECRET / SCHWAB_REDIRECT_URI come from your
# Schwab developer app registration (https://developer.schwab.com). To get
# SCHWAB_REFRESH_TOKEN, fill in the three above first, then run:
#   .venv/Scripts/python.exe scripts/schwab_oauth_bootstrap.py
# and follow the prompts (one-time interactive browser login).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REFRESH_TOKEN=
SCHWAB_REDIRECT_URI=
# Schwab may rotate the refresh token on every use — this is where the rotated
# value gets persisted so a container restart doesn't fall back to the stale
# one above. Gitignored; a real credential lives here once written.
SCHWAB_TOKEN_FILE=.schwab_token.json

# The plain account number of the Schwab account to trade against (from
# schwab.com or the Schwab app — never a "hash", which is looked up
# automatically). Setting this registers SCHWAB_ACCOUNT_ALIAS below as a
# usable `account` value; you still need to add that alias to
# ACCOUNT_ALLOWLIST further down before any order against it is accepted.
SCHWAB_ACCOUNT_NUMBER=
SCHWAB_ACCOUNT_ALIAS=schwab_live

# The explicit opt-in for REAL order submission — deliberately separate from
# everything above, which is also needed for read-only data/preview alone.
# Leave false until you actually want real money at risk.
SCHWAB_LIVE_TRADING_ENABLED=false

# Database
DATABASE_URL=sqlite:///./execution_engine.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/execution_engine

# Server
HOST=0.0.0.0
PORT=8000
ENV=development

# Kill switch (default: OFF)
KILL_SWITCH_ENABLED=false

# Account allowlist (comma-separated). Add SCHWAB_ACCOUNT_ALIAS's value
# here (e.g. "primary,schwab_live") once you want it usable for real.
ACCOUNT_ALLOWLIST=primary,secondary

# Symbol configuration
SYMBOL_ALLOWLIST=QQQ,SPY,IWM,EEM,GLD,TLT
SYMBOL_DENYLIST=

# Risk limits
MAX_ORDER_NOTIONAL_USD=100000
MAX_POSITION_CONCENTRATION_PCT=15
MARKET_HOURS_ONLY=true

# API Security
API_KEY_ADMIN=your-admin-api-key-here
REQUEST_SIGNING_ENABLED=false
REQUEST_SIGNING_PRIVATE_KEY=

# Notifications (optional). A Slack incoming-webhook URL, or a Discord
# webhook URL with /slack appended (Discord accepts the same {"text": ...}
# payload shape at that path) — fired on every kill switch trip/clear and
# every autonomous trade entry/exit. Leave blank to disable.
NOTIFICATION_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Schwab API settings
SCHWAB_API_TIMEOUT_SEC=30
SCHWAB_PREVIEW_TIMEOUT_SEC=10
SCHWAB_PREVIEW_EXPIRY_MIN=5
SCHWAB_RETRY_MAX_ATTEMPTS=3
SCHWAB_RETRY_BACKOFF_SEC=1
# Schwab publishes 120 calls/minute per app. Enforced per PROCESS; with N server workers use 120/N.
SCHWAB_RATE_LIMIT_PER_MINUTE=120
# Longest we will sleep in-line on a Retry-After from Schwab.
SCHWAB_MAX_RETRY_AFTER_SEC=30
